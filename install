#!/bin/sh
# Skye one-time setup. After this, two commands:
#   skye run     start Skye and open it in your browser
#   skye stop    stop it
# Needs: Python 3.10+, git, and Claude Code (logged in: run `claude` once). Node is NOT needed.
set -eu
cd "$(dirname "$0")"
HERE="$(pwd)"

PY=""
for candidate in python3.13 python3.12 python3.11 python3.10 python3; do
  if command -v "$candidate" >/dev/null 2>&1 \
     && "$candidate" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null; then
    PY="$candidate"; break
  fi
done
if [ -z "$PY" ]; then
  echo "skye: Python 3.10 or newer is required (https://www.python.org/downloads/)" >&2
  exit 1
fi

echo "skye: installing into $HERE/.venv ..."
[ -d .venv ] || "$PY" -m venv .venv
.venv/bin/python -m pip install --quiet --disable-pip-version-check -e .

# Put `skye` on PATH: the first user-writable directory already on PATH, else ~/.local/bin.
TARGET=""
for dir in "$HOME/.local/bin" "$HOME/bin" /opt/homebrew/bin /usr/local/bin; do
  case ":$PATH:" in *":$dir:"*) [ -d "$dir" ] && [ -w "$dir" ] && { TARGET="$dir"; break; } ;; esac
done
ON_PATH=1
if [ -z "$TARGET" ]; then
  TARGET="$HOME/.local/bin"; ON_PATH=0
  mkdir -p "$TARGET"
fi
ln -sf "$HERE/.venv/bin/skye" "$TARGET/skye"
echo "skye: linked $TARGET/skye"

command -v claude >/dev/null 2>&1 || echo "skye: ! Claude Code not found - install it from https://claude.com/claude-code and run \`claude\` once to log in"
command -v git >/dev/null 2>&1 || echo "skye: ! git not found - install git"

echo ""
if [ "$ON_PATH" = 0 ]; then
  echo "Add this line to your shell profile (~/.zshrc or ~/.bashrc), then open a new terminal:"
  echo "    export PATH=\"\$HOME/.local/bin:\$PATH\""
  echo ""
fi
echo "Done. Start Skye with:   skye run"
echo "Stop it with:            skye stop"
